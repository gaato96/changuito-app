# Conexión directa a Postgres para la ingesta y las migraciones.
# Producción: Supabase → Project Settings → Database → Connection string → "Session pooler" (puerto 5432).
# Va SOLO en los secretos de GitHub Actions (DATABASE_URL) y en tu .env local; nunca en el repo.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
