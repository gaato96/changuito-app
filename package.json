{
  "name": "changuito",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ingest:vtex": "node --env-file-if-exists=.env.local ingest/vtex/run.ts",
    "ingest:sepa": "node --env-file-if-exists=.env.local ingest/sepa/run.ts",
    "maintenance": "node --env-file-if-exists=.env.local ingest/maintenance/run.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:local": "node scripts/local-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"ingest/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "frescos": "node --env-file-if-exists=.env.local ingest/frescos/suggest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^1.6.1",
    "csv-parse": "^7.0.3",
    "idb": "^8.0.4",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
